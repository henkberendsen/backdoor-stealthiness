# Cache
__pycache__
code/.ipynb_checkpoints/

# Datasets and results (except defenses/results/)
data/
results/
!defenses/results/



# anything inside large_files
large_files/*

# anything inside script_logging
script_logging/*

# anything inside run_files and job_executer_files
run_files/*
job_executer_files/*

# anything in overleaf folder
Overleaf_files/*

# any .tex file, except the result tables the metric matrix is parsed from
*.tex
!/residual_correlations/*.tex

# any md file, except the README files that document the code
*.md
!/README.md
!/analysis/README.md

# editor settings
.vscode/

# text and pdf files outside the tracked results
/*.txt
!/requirements.txt
!/*_tiny.txt
!/feature_steathiness_*.txt
*.pdf
!/analysis/**/*.pdf

# The attack implementations are git submodules of upstream forks; .gitmodules carries
# ignore = all for them, so their pointers only change through an explicit git add <submodule>.
